# Copy to .env and edit. Everything is optional; defaults suit a local demo.

# Comma-separated API keys. Leave EMPTY to keep the API open (demo mode).
# When set, every /v1 request must send header:  X-API-Key: <one of these>
CLIMSMART_API_KEYS=

# Requests per minute per client (API key or IP). 0 = no limit.
CLIMSMART_RATE_LIMIT_PER_MIN=60

# How long to reuse a weather answer for the same location (seconds).
CLIMSMART_CACHE_TTL_SECONDS=3600

# Browser origins allowed to call the API, comma-separated. * = any (demo only).
CLIMSMART_CORS_ORIGINS=*

# Optional: path to your own thresholds file (default: config/thresholds.yaml)
CLIMSMART_THRESHOLDS_FILE=

# Open-Meteo. The FREE service is for NON-COMMERCIAL use only.
# For commercial use, buy a plan and put the key here (or swap the provider).
OPEN_METEO_API_KEY=

# Optional: path to your own agronomy defaults file (TAW, Kc, p + source notes).
# Default: config/agronomy.yaml
CLIMSMART_AGRONOMY_FILE=

# Reverse proxy trust. X-Forwarded-For is believed ONLY when the direct peer is in this list
# (comma-separated IPs/CIDRs). Empty (default, safe) = never trust it, rate-limit on the peer IP.
# With the bundled docker-compose (nginx in front) the compose file sets 172.16.0.0/12 for you.
# Add your outer load balancer/CDN range if one sits in front of nginx; otherwise all visitors
# would share that proxy's address.
CLIMSMART_TRUSTED_PROXIES=

# Weather provider failures: extra attempts after the first (429/5xx/timeout) and base backoff.
CLIMSMART_PROVIDER_RETRIES=2
CLIMSMART_PROVIDER_BACKOFF_SECONDS=0.5

# If the provider is down, serve cached weather up to this old (seconds), clearly marked stale.
CLIMSMART_STALE_MAX_SECONDS=21600

# Logging level (access log: method, path, status, duration, hashed client id; never keys or coordinates)
CLIMSMART_LOG_LEVEL=INFO

# Path to the precomputed APSIM-X result file served by /v1/apsim-outlook (default data/apsim_results/mambang_muda_latest.json)
# CLIMSMART_APSIM_RESULTS_FILE=

# ---- Vercel notes (see README.md) ----
# * Leave CLIMSMART_API_KEYS EMPTY for the public demo. The browser app sends no key (it is built without VITE_API_KEY),
#   so setting keys here would make every page call return 401.
# * CLIMSMART_TRUSTED_PROXIES: api/index.py defaults it to 0.0.0.0/0,::/0 on Vercel (edge overwrites X-Forwarded-For).
#   Only set it to override. Do NOT put another CDN/proxy in front of Vercel without setting it to that proxy's ranges.
# * No variable is REQUIRED. Optional but recommended for a public site: CLIMSMART_CORS_ORIGINS=https://<your-domain>
#   (the web app is same-origin, so CORS only matters for third-party browser callers).
